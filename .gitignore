# Exception: keep standard project files
!README.md
!requirements.txt
!.gitignore

# Local credentials (examples contain placeholders only)
.env
.env.*
!.env.example
*.pem
*.key

# Local runtime state and diagnostics; preserve existing tracked files
/tmp/
/outputs/seat-cutoff/
*.log
*.pid
*.db
