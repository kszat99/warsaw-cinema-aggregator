# Python environment
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/

# IDE settings
.idea/
.vscode/

# Build artifacts
build_output.txt
build.log
dist/showtimes.json
dist/poster_cache.json

# --- Research & Temporary Debris ---
# Ignore all research scripts in root
/analyze_*.py
/explore_*.py
/fetch_*.py
/extract_*.py
/find_api*.py
/inspect_*.py
/debug_*.py
/read_log.py
/test_*.py
/parse_*.py
/clear_*.py

# Ignore HTML/JSON/JS samples in root (Keep index, app, styles)
/*.html
!index.html
/*.json
/*.js
!app.js

# Ignore specific local database or JSON files
/data/
user_mickiewicz.json
cinema_city_sample.json
multikino_api_real.json
multikino_live_nextdata.json
multikino_mlociny.json
multikino_showing_test.json
multikino_uuid_test.json
