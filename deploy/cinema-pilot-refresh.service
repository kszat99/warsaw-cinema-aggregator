[Unit]
Description=Refresh Kinoteka and Arkadia pilot screenings
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cinema-pilot
Group=cinema-pilot
WorkingDirectory=/opt/cinema-pilot
Environment=CINEMA_API_DATABASE_PATH=/var/lib/cinema-pilot/cinema.sqlite3
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/cinema-pilot/.venv/bin/python -m cinema_agg.server.pilot_refresh
TimeoutStartSec=10min
TimeoutStopSec=35
StateDirectory=cinema-pilot
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cinema-pilot
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M
CPUQuota=50%
